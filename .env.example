# Copy to .env (gitignored). A blank value counts as unset. The real environment wins.

# --- STT (python -m voice_services.stt) ---
# VOICE_STT_HOST=127.0.0.1
# VOICE_STT_PORT=8771
# VOICE_STT_MODEL=turbo
# VOICE_STT_DEVICE=auto
# VOICE_STT_LANGUAGES=en,ja

# --- TTS (python -m voice_services.tts) ---
# VOICE_TTS_HOST=127.0.0.1
# VOICE_TTS_PORT=8772
# Upstream api_v2.py processes, one voice each (en + ja today; 3 for en + ja + a second ja).
# VOICE_TTS_POOL_SIZE=2
# Voices loaded at startup, one per instance, e.g. ayaka,rosamund. Others load on first use.
# VOICE_TTS_PRELOAD=
# First localhost port for the upstream processes (one port per instance).
# VOICE_TTS_UPSTREAM_PORT=9890

# --- Per-machine paths (required for TTS; no default for the checkout) ---
# Your GPT-SoVITS checkout, with its CUDA venv under runtime/.
# VOICE_GPT_SOVITS_ROOT=
# Directory holding the trained voice weights (default: a voice-weights dir beside this repo).
# VOICE_WEIGHTS_ROOT=
# ffmpeg bin directory for the upstream process (bundled on Windows; usually on PATH elsewhere).
# VOICE_FFMPEG_BIN=

# --- Hugging Face model cache location (optional; Whisper and fetch_weights.py). ---
# HF_HOME=
# HF_HUB_CACHE=

# --- Where the .env is read from (empty = don't load one; tests set this) ---
# VOICE_ENV_FILE=
